+/**
+ * Domain 14: Schema Migration Management
+ */
+const REQUIRED_SCHEMA_VERSION = 12; // Update this when new SQL patches are released
+
+export async function getSchemaStatus() {
+  try {
+    const { data, error } = await supabase
+      .from('schema_versions')
+      .select('version')
+      .order('version', { ascending: false })
+      .limit(1)
+      .maybeSingle();
+
+    if (error && error.code !== 'PGRST116') throw error;
+    
+    const currentVersion = data?.version || 0;
+    return {
+      currentVersion,
+      requiredVersion: REQUIRED_SCHEMA_VERSION,
+      outdated: currentVersion < REQUIRED_SCHEMA_VERSION
+    };
+  } catch (err) {
+    console.warn("[Migration] Could not fetch schema version:", err);
+    return { currentVersion: 0, requiredVersion: REQUIRED_SCHEMA_VERSION, outdated: true };
+  }
+}
+
+export async function runSchemaMigration(sql) {
+  mutationGuard('runSchemaMigration');
+  
+  // This invokes the edge function responsible for executing raw SQL
+  // The edge function must verify the platform admin JWT claim.
+  const { data, error } = await supabase.functions.invoke('execute-migration', {
+    body: { sql }
+  });
+
+  if (error) throw error;
+  return data;
+}
