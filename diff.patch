+export async function carryForwardFeeStructure(fromPeriodId, toPeriodId) {
+  mutationGuard('carryForwardFeeStructure');
+  if (!_currentSchoolId) throw new Error('No school context');
+
+  const { data: fees, error: fetchErr } = await supabase
+    .from('fees')
+    .select('*')
+    .eq('school_id', _currentSchoolId)
+    .eq('period_id', fromPeriodId);
+
+  if (fetchErr) throw fetchErr;
+  if (!fees || fees.length === 0) return { success: true, count: 0 };
+
+  const { data: students } = await supabase.from('students').select('id, status').eq('school_id', _currentSchoolId).eq('status', 'Enrolled');
+  const enrolledIds = new Set(students?.map(s => s.id) || []);
+
+  const newFees = fees
+    .filter(f => enrolledIds.has(f.student_id))
+    .map(f => {
+      const arrears = Math.max(0, Number(f.total_fee || f.total_expected || 0) - Number(f.paid));
+      return {
+        school_id: _currentSchoolId,
+        student_id: f.student_id,
+        period_id: toPeriodId,
+        total_fee: arrears, // Base for new period before term fees are applied
+        paid: 0,
+        balance: arrears,
+        status: arrears > 0 ? 'Unpaid' : 'Paid'
+      };
+    });
+
+  if (newFees.length === 0) return { success: true, count: 0 };
+
+  const { error: insertErr } = await supabase
+    .from('fees')
+    .upsert(newFees, { onConflict: 'school_id, student_id, period_id' });
+
+  if (insertErr) throw insertErr;
+  await logPlatformActivity('FEES_CARRIED_FORWARD', `Copied ${newFees.length} fee balances to period ${toPeriodId}`);
+  return { success: true, count: newFees.length };
+}
