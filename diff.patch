+/**
+ * Fetch audit logs for the current school.
+ * @param {object} filters - { tableName, actionType, limit, offset }
+ */
+export async function getAuditLogs(filters = {}) {
+  if (!_currentSchoolId) return [];
+  
+  let q = supabase
+    .from('audit_logs')
+    .select('*')
+    .eq('school_id', _currentSchoolId)
+    .order('created_at', { ascending: false })
+    .limit(filters.limit || 50);
+
+  if (filters.tableName) q = q.eq('table_name', filters.tableName);
+  if (filters.actionType) q = q.eq('action_type', filters.actionType);
+  if (filters.offset) q = q.range(filters.offset, filters.offset + (filters.limit || 50) - 1);
+
+  const { data, error } = await q;
+  if (error) throw error;
+  return data || [];
+}
+
+/**
+ * Fetch all audit logs across schools (platform admin only).
+ */
+export async function getAllAuditLogs(filters = {}) {
+  let q = supabase
+    .from('audit_logs')
+    .select('*, schools(name)')
+    .order('created_at', { ascending: false })
+    .limit(filters.limit || 100);
+
+  if (filters.tableName) q = q.eq('table_name', filters.tableName);
+  if (filters.actionType) q = q.eq('action_type', filters.actionType);
+
+  const { data, error } = await q;
+  if (error) throw error;
+  return data || [];
+}
